# Google Gen AI SDK / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=gd-gcp-gridu-genai
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL in Docker Compose
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=synthetic_data
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://app_user:change-me@localhost:5432/synthetic_data

# Langfuse Cloud tracing (leave both keys blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
